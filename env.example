# ── Payload ─────────────────────────────────────────────
PAYLOAD_SECRET=your-payload-secret-here

# Public site origin used for canonical URLs, metadata and sitemaps.
# Local development only; replace with the deployed HTTPS URL before launch.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Claude API used by the profile autofill feature (server-side only).
# Choose the low-cost model by default; configure a spend limit in Anthropic Console too.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Optional Google OAuth for the buyer sign-up modal.
# In Google Cloud Console, add:
#   http://localhost:3000/api/auth/google/callback
# as an authorized redirect URI for local development.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Supabase Postgres ───────────────────────────────────
# Supabase → Project Settings → Database → Connection string.
# Use the "Session pooler" (port 5432) or the direct connection; avoid the transaction pooler (6543) for migrations.
DATABASE_URI=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
# DATABASE_SSL=true      # auto-enabled for non-localhost hosts; set "false" to disable
# Connections per server process. Production default 2 (many serverless instances share the pooler).
# DATABASE_POOL_MAX=2
# Used instead by `next dev` (one process, bursts of parallel queries after each hot reload). Default 10.
# DATABASE_POOL_MAX_DEV=10

# ── Supabase Storage (S3-compatible) for the Media collection ──
# Supabase → Storage → create a PUBLIC bucket (e.g. "media"), then Settings → S3 Connection → create access keys.
# Leave these empty to store uploads on local disk (./media) instead.
S3_BUCKET=media
S3_REGION=ap-south-1
S3_ENDPOINT=https://[YOUR-PROJECT-REF].storage.supabase.co/storage/v1/s3
S3_ACCESS_KEY_ID=your-s3-access-key-id
S3_SECRET_ACCESS_KEY=your-s3-secret-access-key
# Use a matching generated S3 key pair, not Supabase API keys or the database password.
# Copy S3_REGION and S3_ENDPOINT from the same project's S3 configuration page.
# After editing .env, restart Next.js and run: npm run storage:check
S3_PUBLIC_URL=https://[YOUR-PROJECT-REF].supabase.co/storage/v1/object/public/media

# ── Seeding (npm run seed) ──────────────────────────────
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=your-secure-admin-password

# ── Search engines (optional) ───────────────────────────
# Ownership tags for Google Search Console and Bing Webmaster Tools (the content value of their meta tag).
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
# IndexNow key (8–128 letters, digits or dashes). When set, production pings Bing/IndexNow on listing and broker changes.
INDEXNOW_KEY=

# ── SEO content agent (optional) ────────────────────────
# Protects /api/seo-agent/run. Vercel Cron sends it as "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=
# Model for the agent (default claude-opus-5-5). Uses ANTHROPIC_API_KEY; usage is logged as platform work.
SEO_AGENT_MODEL=
# true = validated content goes live without review in Payload admin (SEO content). Default: review first.
SEO_AGENT_AUTO_APPROVE=false
