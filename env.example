# ── Payload ─────────────────────────────────────────────
PAYLOAD_SECRET=your-payload-secret-here

# Public site origin used for canonical URLs, metadata and sitemaps.
# Local development only; replace with the deployed HTTPS URL before launch.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional Google OAuth for the buyer sign-up modal.
# In Google Cloud Console, add:
#   http://localhost:3000/api/auth/google/callback
# as an authorized redirect URI for local development.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Supabase Postgres ───────────────────────────────────
# Supabase → Project Settings → Database → Connection string.
# Use the "Session pooler" (port 5432) or the direct connection; avoid the transaction pooler (6543) for migrations.
DATABASE_URI=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
# DATABASE_SSL=true      # auto-enabled for non-localhost hosts; set "false" to disable
# DATABASE_POOL_MAX=10

# ── Supabase Storage (S3-compatible) for the Media collection ──
# Supabase → Storage → create a PUBLIC bucket (e.g. "media"), then Settings → S3 Connection → create access keys.
# Leave these empty to store uploads on local disk (./media) instead.
S3_BUCKET=media
S3_REGION=ap-south-1
S3_ENDPOINT=https://[YOUR-PROJECT-REF].storage.supabase.co/storage/v1/s3
S3_ACCESS_KEY_ID=your-s3-access-key-id
S3_SECRET_ACCESS_KEY=your-s3-secret-access-key
# Use a matching generated S3 key pair, not Supabase API keys or the database password.
# Copy S3_REGION and S3_ENDPOINT from the same project's S3 configuration page.
# After editing .env, restart Next.js and run: npm run storage:check
S3_PUBLIC_URL=https://[YOUR-PROJECT-REF].supabase.co/storage/v1/object/public/media

# ── Seeding (npm run seed) ──────────────────────────────
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=your-secure-admin-password
